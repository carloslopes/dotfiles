# Template for .secrets — copy, fill in, and keep it out of git:
#
#   cp .secrets.example .secrets
#   chmod 600 .secrets
#
# .secrets is gitignored and sourced at the end of zshrc.local, which is public.

# Auth token for the Claude Code OTEL collector.
# Consumed by claude.settings.json via ${CLAUDE_OTEL_TOKEN} expansion.
export CLAUDE_OTEL_TOKEN=

# Bartender Pro NotchBar AgentStatus install dir (machine-specific path, not a credential —
# kept here so the absolute path stays out of the versioned settings file).
# Consumed by claude.settings.json hooks via "$NOTCHBAR_AGENTS_DIR" expansion.
# Leave unset on machines without NotchBar installed.
export NOTCHBAR_AGENTS_DIR=
