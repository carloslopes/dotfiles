{
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://34.68.28.254:4318",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_HEADERS": "Authorization=Bearer ${CLAUDE_OTEL_TOKEN}"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(rspec:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(git checkout:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(gh pr:*)",
      "Bash(rubocop:*)",
      "Bash(find:*)"
    ],
    "deny": []
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/carloslopes/.claude/statusline-command.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$NOTCHBAR_AGENTS_DIR/hooks/claude-event-hook.sh\" Idle # notchbar-agents-claude-hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$NOTCHBAR_AGENTS_DIR/hooks/claude-event-hook.sh\" Working # notchbar-agents-claude-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$NOTCHBAR_AGENTS_DIR/hooks/claude-event-hook.sh\" Working # notchbar-agents-claude-hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$NOTCHBAR_AGENTS_DIR/hooks/claude-event-hook.sh\" Auto # notchbar-agents-claude-hook"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$NOTCHBAR_AGENTS_DIR/hooks/claude-event-hook.sh\" ToolFail # notchbar-agents-claude-hook"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$NOTCHBAR_AGENTS_DIR/hooks/claude-event-hook.sh\" Waiting # notchbar-agents-claude-hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$NOTCHBAR_AGENTS_DIR/hooks/claude-event-hook.sh\" Idle # notchbar-agents-claude-hook"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$NOTCHBAR_AGENTS_DIR/hooks/claude-event-hook.sh\" Ended # notchbar-agents-claude-hook"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    }
  },
  "effortLevel": "high",
  "preferredNotifChannel": "terminal_bell",
  "agentPushNotifEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1753968511680
  },
  "settingSources": [
    "user",
    "project"
  ]
}
